@inherits LayoutComponentBase
@inject IConfiguration Configuration

<div class="p-2 d-flex align-items-center align-content-between bg-primary">
    <button class="btn btn-primary text-uppercase"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#leftMenu"
            aria-controls="leftMenu">
        <i class="bi bi-grid me-1"></i>
        Menu
    </button>

    @if (Configuration.GetValue<bool>("Authentication:Oidc:Enabled"))
    {
        <AuthorizeView>
            <Authorized>
                <form method="post" action="/account/sign-out" class="ms-auto">
                    <button type="submit" class="btn btn-link text-white text-decoration-none">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Sign out
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-link text-white text-decoration-none ms-auto" href="/account/sign-in?returnUrl=/">
                    <i class="bi bi-box-arrow-in-right me-1"></i>
                    Sign in
                </a>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="leftMenu" aria-labelledby="leftMenuLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="leftMenuLabel">
            <i class="bi bi-grid me-1"></i>
            Navigation
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="list-group" id="navList">
            <NavLink class="list-group-item list-group-item-action" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-house me-2"></i>
                Home
            </NavLink>
            <NavLink class="list-group-item list-group-item-action" href="/counter">
                <i class="bi bi-plus-slash-minus me-2"></i>
                Counter
            </NavLink>
        </div>
    </div>
</div>

<main class="container-fluid py-2">
    @Body
</main>
