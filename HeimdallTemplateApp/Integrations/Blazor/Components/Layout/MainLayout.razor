@inherits LayoutComponentBase
@inject IConfiguration Configuration

<ToastHost />

<div class="p-2 d-flex align-items-center align-content-between bg-primary">
    <div class="w-100 d-flex align-items-center justify-content-between">
        <button class="btn btn-primary text-uppercase"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#leftMenu"
                aria-controls="leftMenu">
            <i class="bi bi-grid me-1"></i>
            Menu
        </button>

        @if (Configuration.GetValue<bool>("Authentication:Oidc:Enabled"))
        {
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/account/sign-out">
                        <button type="submit" class="btn btn-link text-white text-decoration-none">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Sign out
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-link text-white text-decoration-none" href="/account/sign-in">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Sign in
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        }
    </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="leftMenu" aria-labelledby="leftMenuLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="leftMenuLabel">
            <i class="bi bi-grid"></i>
            Navigation
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="list-group" id="navList">
            <a class="list-group-item list-group-item-action" href="/">
                <i class="bi bi-house me-2"></i>
                Home
            </a>
            <a class="list-group-item list-group-item-action" href="/out-of-band">
                <i class="bi bi-chat-dots me-2"></i>
                Out Of Band
            </a>
            <a class="list-group-item list-group-item-action" href="/state">
                <i class="bi bi-bezier2 me-2"></i>
                State
            </a>
            <a class="list-group-item list-group-item-action" href="/forms">
                <i class="bi bi-journal me-2"></i>
                Forms
            </a>
            <a class="list-group-item list-group-item-action" href="/lazy">
                <i class="bi bi-arrow-repeat me-2"></i>
                Lazy Loading
            </a>
        </div>
    </div>
</div>

<div class="container-fluid py-2">
    <main role="main" class="pb-3">
        @Body
    </main>
</div>
