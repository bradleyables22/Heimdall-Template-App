@using HeimdallTemplateApp.Models

<form id="create-note-form"
      heimdall-content-submit="notes.create"
      heimdall-payload-from="closest-form"
      heimdall-content-target="#create-note-host"
      heimdall-content-swap="inner"
      heimdall-prevent-default="true">
    <label class="form-label" for="title">Title</label>
    <input id="title"
           name="@nameof(CreateNoteRequest.Title)"
           value="@Request.Title"
           maxlength="125"
           class="form-control mb-1" />

    @if (ShowErrors && Errors.TryGetValue(nameof(CreateNoteRequest.Title), out var titleError))
    {
        <div class="form-text text-danger mb-3">@titleError</div>
    }
    else
    {
        <div class="mb-3"></div>
    }

    <label class="form-label" for="content">Content</label>
    <textarea id="content"
              name="@nameof(CreateNoteRequest.Content)"
              maxlength="500"
              rows="5"
              class="form-control mb-1">@Request.Content</textarea>

    @if (ShowErrors && Errors.TryGetValue(nameof(CreateNoteRequest.Content), out var contentError))
    {
        <div class="form-text text-danger mb-3">@contentError</div>
    }
    else
    {
        <div class="mb-3"></div>
    }

    <div class="row">
        <div class="col-lg-12">
            <button class="btn btn-primary w-100" type="submit">Submit</button>
        </div>
    </div>
</form>

@code {
    [Parameter] public CreateNoteRequest Request { get; set; } = new();
    [Parameter] public bool ShowErrors { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> Errors { get; set; } = new Dictionary<string, string>();
}
