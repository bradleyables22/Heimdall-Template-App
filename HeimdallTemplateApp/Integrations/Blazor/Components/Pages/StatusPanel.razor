<section id="status-panel" class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Blazor component target</h2>
        @if (RefreshedAt is null)
        {
            <p class="mb-0">This region is rendered by a Blazor component and can be replaced by a Heimdall content action.</p>
        }
        else
        {
            <p class="mb-0">Rendered by the component at @RefreshedAt.Value.ToString("T").</p>
        }
    </div>
</section>

@code {
    [Parameter]
    public DateTimeOffset? RefreshedAt { get; set; }
}
