{
  "$schema": "http://json.schemastore.org/template",
  "author": "Bradley Ables",
  "classifications": ["Web", "ASP.NET", "Heimdall", "SSG"],
  "identity": "Heimdall.Ssg.Template",
  "groupIdentity": "Heimdall.Ssg",
  "name": "Heimdall Static Site Generator",
  "shortName": "heimdall-ssg",
  "sourceName": "HeimdallTemplateApp",
  "description": "Heimdall static site generator with artifact and web-root output modes.",
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "description": "The target framework for the generated application.",
      "replaces": "net10.0",
      "choices": [{ "choice": "net10.0", "description": ".NET 10.0" }]
    },
    "output-mode": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "artifact",
      "description": "Choose where the generated static site is written.",
      "choices": [
        { "choice": "artifact", "description": "Static artifact in dist/" },
        { "choice": "web-root", "description": "ASP.NET Core web root in wwwroot/" }
      ]
    },
    "IsArtifact": { "type": "computed", "value": "(output-mode == \"artifact\")" },
    "IsWebRoot": { "type": "computed", "value": "(output-mode == \"web-root\")" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [{
        "exclude": [
          ".template.config/**",
          "TemplateVariants/**",
          "Program.cs",
          "HeimdallTemplateApp.csproj",
          "Helpers/RenderAssistant.cs",
          "Rendering/HomePage.cs",
          "Rendering/NotFoundPage.cs",
          "Rendering/SiteLayout.cs",
          "Services/SiteContent.cs",
          "Views/Shared/_MvcDocs.cshtml"
        ]
      }]
    },
    {
      "source": "./TemplateVariants/Artifact/",
      "target": "./",
      "condition": "IsArtifact"
    },
    {
      "source": "./TemplateVariants/WebRoot/",
      "target": "./",
      "condition": "IsWebRoot"
    },
    {
      "source": "./TemplateVariants/Static/",
      "target": "./"
    },
    {
      "source": "../../Integrations/Mvc/wwwroot/css/",
      "target": "./wwwroot/css/vendor/",
      "modifiers": []
    },
    {
      "source": "../../Integrations/Mvc/wwwroot/js/",
      "target": "./wwwroot/js/vendor/",
      "modifiers": [{
        "exclude": [
          "heimdall.debug.js",
          "heimdall.config.js"
        ]
      }]
    }
  ],
  "preferNameDirectory": true
}
