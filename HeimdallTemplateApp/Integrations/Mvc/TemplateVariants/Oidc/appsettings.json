{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Oidc": {
      "Enabled": true,
      "Authority": "https://your-identity-provider.example",
      "ClientId": "replace-with-client-id",
      "ClientSecret": "replace-with-client-secret",
      "CallbackPath": "/signin-oidc",
      "RequireHttpsMetadata": true
    }
  }
}
