{
  "$schema": "http://json.schemastore.org/template",
  "author": "Bradley Ables",
  "classifications": ["Web", "ASP.NET", "Heimdall", "MVC", "SSR"],
  "identity": "Heimdall.Mvc.Template",
  "groupIdentity": "Heimdall.Mvc",
  "name": "Heimdall MVC Application",
  "shortName": "heimdall-mvc",
  "sourceName": "HeimdallTemplateApp",
  "description": "ASP.NET Core MVC application with Heimdall actions and HTML rendering.",
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "authentication": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "description": "Choose whether to include the optional OpenID Connect authentication scaffold.",
      "choices": [
        { "choice": "none", "description": "No external sign-in provider" },
        { "choice": "oidc", "description": "OpenID Connect sign-in with cookie sessions" }
      ]
    },
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "description": "The target framework for the generated application.",
      "replaces": "net10.0",
      "choices": [{ "choice": "net10.0", "description": ".NET 10.0" }]
    },
    "IsOidc": { "type": "computed", "value": "(authentication == \"oidc\")" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            "TemplateVariants/**",
            "Program.cs",
            "HeimdallTemplateApp.csproj",
            "appsettings.json",
            "Views/Shared/_Menu.cshtml"
          ]
        }
      ]
    },
    {
      "source": "../../Authentication/",
      "target": "./Authentication/",
      "condition": "IsOidc",
      "modifiers": []
    },
    {
      "source": "./TemplateVariants/NoAuth/",
      "target": "./",
      "condition": "!IsOidc"
    },
    {
      "source": "./TemplateVariants/Oidc/",
      "target": "./",
      "condition": "IsOidc"
    }
  ],
  "preferNameDirectory": true
}
